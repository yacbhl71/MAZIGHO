# MAZIGHO — environment variables
# Copy to .env for local development. On Vercel, set these in
# Settings > Environment Variables. Never commit real secrets.

# --- Core (required) ---
# MySQL / TiDB Cloud connection string (includes the password)
DATABASE_URL=mysql://user.root:password@gateway01.<region>.prod.aws.tidbcloud.com:4000/mazigho
# Dedicated session signing secret (recommended). If omitted, a secret is
# derived from DATABASE_URL (rotating the DB password then logs everyone out).
JWT_SECRET=change-me-with-a-long-random-string
NODE_ENV=production
PORT=3000
# Public base URL used to build Stripe success/cancel links
PUBLIC_APP_URL=https://mazigho.ch

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Brevo e-mail (optional; transactional messages and marketing drafts) ---
# The sender address must be verified in Brevo. Never commit a real API key.
BREVO_API_KEY=xkeysib_xxx
BREVO_SENDER_EMAIL=securite@notifications.mazigho.ch
BREVO_SENDER_NAME=MAZIGHO Sécurité
# Public base URL used for password reset and account invitation links.
MAZIGHO_PUBLIC_URL=https://www.mazigho.ch

# --- CJdropshipping ---
CJ_API_KEY=your-cj-api-key
# Optional default USD -> CHF rate used to prime the import form (client side)
VITE_CJ_USD_CHF_RATE=0.90

# --- Odoo (optional; enables automatic order/customer sync on paid Stripe order) ---
# JSON-RPC integration. When these are unset, the sync is skipped gracefully.
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your-odoo-database
ODOO_USERNAME=your-odoo-login-email
# Prefer an Odoo API key; ODOO_PASSWORD is used as a fallback.
ODOO_API_KEY=your-odoo-api-key
# ODOO_PASSWORD=your-odoo-password
# Optional: map every sale.order line to this Odoo product id. If unset, orders
# are created with an itemised summary in the order note instead of priced lines.
ODOO_DEFAULT_PRODUCT_ID=

# --- Make.com automation (optional) ---
MAKE_INTEGRATION_ENABLED=false
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_API_KEY=
MAKE_WEBHOOK_TIMEOUT_MS=8000

# --- Manus WebDev OAuth (optional social login; email/password works without it) ---
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
# --- Storefront media uploads (Vercel Blob, recommended for production) ---
# Provision a public Blob store in Vercel and connect it to the project. The
# token is added by Vercel; never copy a real token into this file or Git.
BLOB_READ_WRITE_TOKEN=
